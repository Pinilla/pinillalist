{
  "name": "pinillalist",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server/main.ts & vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "migrate": "node scripts/migrate.ts",
    "import-anylist": "node scripts/import-anylist.ts",
    "set-password": "node scripts/set-password.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
